# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Instagram / Meta App — "Instagram API with Unified Login" (single owner, no OAuth)
# Dashboard: https://developers.facebook.com/apps/ -> Use cases -> Instagram API -> API setup with Unified login
# System User Access Token from step 2 "Generate access tokens" (never expires). Server-only.
IG_ACCESS_TOKEN=
# Meta app secret (App settings -> Basic). Meta signs webhook deliveries with it.
META_APP_SECRET=
# Any random string; enter the same value in the webhook subscription form in the dashboard.
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=

# AI Auto-Reply (optional — enables the AI toggle in Automations)
# Get a free Groq key at https://console.groq.com (recommended, fast + free)
# Or use any OpenAI-compatible provider: set AI_BASE_URL + AI_MODEL + one of the keys below
GROQ_API_KEY=
# OPENAI_API_KEY=
# AI_BASE_URL=https://api.groq.com/openai/v1/chat/completions
# AI_MODEL=llama-3.1-8b-instant

# Password for the dashboard (any user name, this password). Required.
DASHBOARD_PASSWORD=
