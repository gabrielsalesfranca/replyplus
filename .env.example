# Supabase (set automatically by the Supabase integration on Vercel)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres URL: if set, `pnpm build` applies schema.sql automatically.
POSTGRES_URL_NON_POOLING=

# Dashboard password (HTTP Basic Auth; any username)
DASHBOARD_PASSWORD=

# Optional: the setup screen saves these in the database instead. Env vars win if set.
# Meta app secret (App settings -> Basic). Meta signs webhook deliveries with it.
META_APP_SECRET=
# Webhook verify token; the setup screen generates one if empty.
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
# System User Access Token, used when the login screen's token field is left empty.
IG_ACCESS_TOKEN=

# AI Auto-Reply (optional — enables the AI toggle in Automations)
# Get a free Groq key at https://console.groq.com (recommended, fast + free)
# Or use any OpenAI-compatible provider: set AI_BASE_URL + AI_MODEL + one of the keys below
GROQ_API_KEY=
# OPENAI_API_KEY=
# AI_BASE_URL=https://api.groq.com/openai/v1/chat/completions
# AI_MODEL=llama-3.1-8b-instant
